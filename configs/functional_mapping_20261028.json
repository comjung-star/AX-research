  "algorithm": "Untrained bilingual action-object-output production grammar; experimental interpretable baseline, not professor-confirmed neural interaction",
  "task_evidence": "Only positive Task clauses license an executed function. Context describes applicability only; Problem never licenses implementation. Task is existing structured summary, not independently reverified source full text.",
  "clause_separator": "[.;。；\\n]",
  "max_action_object_span": 120,
  "negation_guard": "\\b(?:not|never|without|cannot|can't|doesn't|does not|no longer|planned|proposed|future|requires?|needs?|should|would|could|aims?|hopes?|wants?)\\b|하지 않|못하|미구현|미지원|예정|계획 중|필요하|도입 검토|구현 전|목표로",
  "query_inheritance": "No hidden original-query text appended. Branch-local functions scored on branch text; if none, unresolved. Whole original is separately mapped and retained in final ranking. source_quote must be literal original substring.",
  "mapping_grade": {
    "4": "Shared supported functional production AND shared non-generic object domain AND compatible Problem/Context functional evidence. This is rule support, not verified relevance.",
    "3": "At least one common action/object production with output type explicitly defined by that operation; cross-industry allowed. Partial whole-question coverage separately reported.",
    "2": "Same action but different functional object families; only auxiliary overlap, not supported core function.",
    "1": "Object/domain overlap only; no function claim.",
    "0": "No recognized supported overlap; UNKNOWN if parser cannot establish functions, never treat as proven irrelevance."
  },
  "final_order": ["max(whole_grade, best_perspective_grade)", "whole_grade", "best_perspective_grade", "unchanged saved hybrid retrieval score", "case_id ascending"],
  "perspective_aggregation": "max, not sum; preserve every branch; no count bonus. Unknown branches cannot invent a function; whole-problem evaluation remains independent.",
  "conditions": {"M_O_SINGLE": "original mapping, original Single hybrid tie-break", "M_D_SINGLE": "whole plus perspective mapping, dynamic Single hybrid tie-break; primary final recommender", "M_O_THREE": "original mapping, original 3View hybrid tie-break; secondary", "M_D_THREE": "whole plus perspective mapping, dynamic 3View hybrid tie-break; secondary"},
  "candidate_count": 112,
  "K": [5, 10, 20],
  "no_training": true,
  "no_silver_mapper_input": true,
  "api_calls": 0,
  "api_key_reads": 0,
  "independent_test_access": false,
  "development_stage4_only": true,
