        "content": [
          {
            "type": "output_text",
            "annotations": [],
            "logprobs": [],
            "text": "{\"decisions\":[{\"id\":\"P01\",\"status\":\"SELECTED\",\"relation\":\"PROBLEM_HYPOTHESIS\",\"anchor_quote\":\"여러 부서가 연결된 환경\",\"bridge_reason\":\"여러 부서가 연결된 문의 흐름에서는 답변 근거와 정책이 여러 팀·시스템에 흩어져 있어, 상담원이나 담당자가 필요한 정보를 빨리 찾지 못해 전달 지연이 커질 수 있습니다.\",\"assumptions\":[\"팀 간 전달 지연의 일부 원인이 분산된 정책·업무지식 탐색 부담일 수 있습니다.\",\"반복 문의 중 일부는 기존 답변 근거를 쉽게 찾지 못해 재확인·재문의가 발생하는 상황일 수 있습니다.\"],\"missing_information\":[\"상담원이나 중간 담당자가 실제로 여러 문서·시스템을 찾아보느라 시간이 걸리는지\",\"부서별 정책·처리기준·이력 정보가 분산돼 있는지\",\"반복 문의가 주로 FAQ형인지, 케이스별 조사형인지\"]},{\"id\":\"P02\",\"status\":\"NOT_SELECTED\",\"relation\":\"NONE\",\"anchor_quote\":\"처리 중에 팀 간 전달이 늦어지면서\",\"bridge_reason\":\"질문에는 비정형 자료에서 정보를 수기로 추출·구조화하는 부담이 직접 나오지 않습니다. 전달 지연과 반복 문의만으로 추출·분류 업무를 연결하기는 어렵습니다.\",\"assumptions\":[],\"missing_information\":[\"이관 전에 이메일·메모·첨부파일에서 정보를 수기로 CRM/티켓에 옮기는 단계가 있는지\"]},{\"id\":\"P03\",\"status\":\"PENDING\",\"relation\":\"PROBLEM_HYPOTHESIS\",\"anchor_quote\":\"팀 간 전달이 늦어지면서 응답 흐름이 자주 끊깁니다\",\"bridge_reason\":\"부서 간 이관이 늦는 이유가 필수정보 누락 확인, 정책 기준 대조, 접수 내용 검증 같은 검토 단계라면 검증 부담 관점이 맞을 수 있습니다. 다만 질문만으로는 단순 병목인지 검증 업무인지 확정하기 어렵습니다.\",\"assumptions\":[\"전달 전후에 필수항목 완전성 확인이나 기준 대조가 병목일 수 있습니다.\"],\"missing_information\":[\"이관 시 체크리스트·승인기준·정책 대조가 실제로 있는지\",\"재작업 원인이 정보 누락/오류 검토인지 단순 대기열인지\",\"부서 간 전달 시 필수 입력항목 검증이 필요한지\"]},{\"id\":\"P04\",\"status\":\"SELECTED\",\"relation\":\"QUERY_EXPLICIT\",\"anchor_quote\":\"고객센터에서 비슷한 문의가 반복해서 들어오고, 처리 중에 팀 간 전달이 늦어지면서 응답 흐름이 자주 끊깁니다.\",\"bridge_reason\":\"반복 문의 유입과 응답 흐름 단절은 문의 응대량과 운영 경로가 현재 처리 용량을 넘거나 비효율적이라는 신호라서, 고객 문의 상시 응대·상담원 인계·자가응답 완화 사례와 직접 연결됩니다.\",\"assumptions\":[],\"missing_information\":[\"문의가 몰리는 채널과 시간대가 어디인지\",\"반복 문의 중 자동응답이나 셀프서비스로 전환 가능한 비율이 있는지\",\"사람 상담 전후 어느 단계에서 가장 오래 지연되는지\"]}],\"constraints\":[{\"kind\":\"condition\",\"perspective_id\":\"ALL\",\"quote\":\"우리처럼 여러 부서가 연결된 환경에서\"},{\"kind\":\"condition\",\"perspective_id\":\"P04\",\"quote\":\"비슷한 문의가 반복해서 들어오고\"},{\"kind\":\"condition\",\"perspective_id\":\"P01\",\"quote\":\"팀 간 전달이 늦어지면서\"}],\"unsupported_work\":[]}"
