            "type": "output_text",
            "annotations": [],
            "logprobs": [],
            "text": "{\"decisions\":[{\"id\":\"P01\",\"status\":\"SELECTED\",\"relation\":\"QUERY_EXPLICIT\",\"anchor_quote\":\"공공서비스 관련 규정을 검토한 뒤 민원이나 신청 건을 어느 부서로 넘겨야 하는지 판단하는 과정\",\"bridge_reason\":\"규정과 처리 기준을 찾아 근거로 참조하는 부담이 직접 나타납니다. 규정 확인과 이관 판단 사이의 맥락 단절을 줄이기 위한 지식 검색·참조 사례가 우선적으로 맞습니다.\",\"assumptions\":[],\"missing_information\":[],\"search_role\":\"MAIN\"},{\"id\":\"P02\",\"status\":\"PENDING\",\"relation\":\"PROBLEM_HYPOTHESIS\",\"anchor_quote\":\"중간에 맥락이 자주 끊깁니다.\",\"bridge_reason\":\"만약 민원·신청 내용이나 예외사항을 사람이 문서에서 다시 정리해 다음 단계로 넘기는 과정이 있다면, 정보 추출·구조화 사례가 맥락 손실을 줄이는 보조 관점이 될 수 있습니다.\",\"assumptions\":[\"민원·신청 건의 핵심 정보가 자유서술·첨부 문서에 있고 이를 사람이 옮겨 적거나 재정리한다.\",\"부서 이관 판단에 필요한 정보가 현재 일관된 구조 데이터로 유지되지 않는다.\"],\"missing_information\":[\"민원·신청 건에서 수기 추출·입력 또는 재정리 단계가 있는지\",\"이관 판단에 필요한 필드가 이미 구조화되어 있는지\"],\"search_role\":\"NONE\"},{\"id\":\"P03\",\"status\":\"SELECTED\",\"relation\":\"QUERY_EXPLICIT\",\"anchor_quote\":\"해석이 조금만 달라도 담당자마다 처리 흐름이 달라지는 문제가 있습니다.\",\"bridge_reason\":\"같은 신청·민원을 규정, 예외 기준과 대조해 일관되게 판단해야 하는 문제입니다. 기준 대조·검증 사례가 처리 편차와 누락을 줄이는 방향과 직접 연결됩니다.\",\"assumptions\":[],\"missing_information\":[],\"search_role\":\"MAIN\"},{\"id\":\"P04\",\"status\":\"NOT_SELECTED\",\"relation\":\"NONE\",\"anchor_quote\":\"해석이 조금만 달라도 담당자마다 처리 흐름이 달라지는 문제가 있습니다.\",\"bridge_reason\":\"질문의 중심은 문의량이나 응대 용량 부족이 아니라 규정 해석의 일관성과 이관 판단 흐름입니다.\",\"assumptions\":[],\"missing_information\":[],\"search_role\":\"NONE\"}],\"constraints\":[],\"unsupported_work\":[{\"quote\":\"규정 확인, 예외사항 검토, 담당 부서 이관까지 한 흐름으로 운영해야 하는데 중간에 맥락이 자주 끊깁니다.\",\"reason\":\"단계 간 맥락 유지와 이관 흐름 운영 자체는 질문의 중요한 업무이지만, 제공된 관점들은 검색·추출·검증·응대용량 사례 중심이라 전체 워크플로 오케스트레이션을 직접 다루는 관점은 없습니다.\"}]}"
          }
